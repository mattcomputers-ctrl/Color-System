# Database
DATABASE_URL=postgresql://colorformulation:changeme@localhost:5432/colorformulation

# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# JWT
JWT_SECRET_KEY=change-this-to-another-random-secret-key
JWT_ACCESS_TOKEN_EXPIRES=3600

# File uploads
UPLOAD_FOLDER=/var/lib/colorformulation/uploads
MAX_CONTENT_LENGTH=16777216

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/colorformulation/app.log
